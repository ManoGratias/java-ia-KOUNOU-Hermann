{
  "folders": [
    { "name": "projet1 - Quiz", "path": "projet1" },
    { "name": "projet2 - Tâches", "path": "projet2" },
    { "name": "projet3 - Chatbot", "path": "projet3" }
  ],
  "settings": {
    "files.encoding": "utf8"
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "Fenêtre - Quiz",
        "request": "launch",
        "mainClass": "quiz.QuizFenetre",
        "cwd": "${workspaceFolder:projet1 - Quiz}"
      },
      {
        "type": "java",
        "name": "Fenêtre - Tâches",
        "request": "launch",
        "mainClass": "taches.TachesFenetre",
        "cwd": "${workspaceFolder:projet2 - Tâches}"
      },
      {
        "type": "java",
        "name": "Fenêtre - Chatbot",
        "request": "launch",
        "mainClass": "chatbot.ChatFenetre",
        "cwd": "${workspaceFolder:projet3 - Chatbot}",
        "envFile": "${workspaceFolder:projet3 - Chatbot}/.env"
      },
      {
        "type": "java",
        "name": "Console - Quiz",
        "request": "launch",
        "mainClass": "quiz.Quiz",
        "cwd": "${workspaceFolder:projet1 - Quiz}",
        "console": "integratedTerminal"
      },
      {
        "type": "java",
        "name": "Console - Tâches",
        "request": "launch",
        "mainClass": "taches.Main",
        "cwd": "${workspaceFolder:projet2 - Tâches}",
        "console": "integratedTerminal"
      },
      {
        "type": "java",
        "name": "Console - Chatbot",
        "request": "launch",
        "mainClass": "chatbot.Main",
        "cwd": "${workspaceFolder:projet3 - Chatbot}",
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder:projet3 - Chatbot}/.env"
      }
    ]
  }
}
